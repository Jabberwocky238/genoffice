# EE engines are published to GitHub Packages; installing them needs a token with read:packages
# (GITHUB_TOKEN). Without one npm skips them (optionalDependencies) and only the rsword mode is unavailable.
@lilleapo:registry=https://npm.pkg.github.com
@jabberwocky238:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN?}
